---
import { etapas } from '../data/site.js';
---
<section id="metodo" class="mt">
  <div class="wrap">
    <h2 class="h-lg">Do diagnóstico<br />ao resultado.</h2>
    <!-- uma coluna por etapa: acrescentar ou tirar etapas em site.js não quebra a linha do tempo -->
    <div class="mt__steps" data-timeline style={`--etapas: ${etapas.length}`}>
      <div class="mt__rail" aria-hidden="true"><span data-timeline-fill></span></div>
      <ol class="mt__list">
      {etapas.map((e, i) => (
        <li class="mt__step" data-step>
          <span class="mt__dot" aria-hidden="true"></span>
          <span class="mt__n">Etapa {i + 1}</span>
          <h3>{e.titulo}</h3>
          <p>{e.texto}</p>
        </li>
      ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .mt { padding: var(--section) 0 var(--section-end); }
  .mt__steps { position: relative; margin-top: clamp(40px, 5vw, 64px); padding-top: 40px; }
  .mt__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--etapas, 3), minmax(0, 1fr)); gap: 32px; }
  .mt__rail { position: absolute; left: 0; right: 0; top: 7px; height: 2px; background: rgba(11, 26, 46, 0.1); }
  .mt__rail span { position: absolute; inset: 0; background: var(--teal); transform-origin: left; transform: scaleX(0); }
  .mt__step { position: relative; display: flex; flex-direction: column; gap: 8px; }
  .mt__dot { position: absolute; top: -40px; left: 0; width: 16px; height: 16px; border-radius: 50%; background: var(--paper); border: 2px solid rgba(11, 26, 46, 0.5); transition: background .25s ease, border-color .25s ease, transform .25s var(--ease); }
  .mt__step.is-on .mt__dot { background: var(--green); border-color: var(--green); transform: scale(1.25); }
  .mt__n { font-size: 14px; font-weight: 700; color: var(--teal-ink); }
  .mt__step h3 { font-size: clamp(22px, 2vw, 28px); letter-spacing: -0.025em; }
  .mt__step p { color: var(--muted); font-size: 15px; max-width: 320px; }
  @media (max-width: 860px) {
    .mt__steps { padding: 0 0 0 36px; }
    .mt__list { grid-template-columns: 1fr; gap: 36px; }
    .mt__rail { left: 7px; right: auto; top: 0; bottom: 0; width: 2px; height: auto; }
    .mt__rail span { transform-origin: top; transform: scaleY(0); }
    .mt__dot { top: 2px; left: -36px; }
  }
</style>
