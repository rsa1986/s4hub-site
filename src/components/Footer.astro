---
import { temClientes } from '../data/site.js';
const ano = new Date().getFullYear();
---
<footer class="ft dark">
  <div class="wrap ft__top">
    <img src="/img/logo-h-dark.png" alt="S4 Hub" width="600" height="215" class="ft__logo" />
    <nav class="ft__nav" aria-label="Rodapé">
      <a href="#solucoes">Soluções</a>
      <a href="#metodo">Método</a>
      {temClientes && <a href="#clientes">Clientes</a>}
      <a href="#duvidas">Dúvidas</a>
      <a href="#contato">Contato</a>
    </nav>
  </div>
  <div class="wrap rule-top ft__bottom">
    <p>Seu hub de soluções em Vendas e Marketing.</p>
    <p class="ft__legal">
      <span>© {ano} S4 Hub</span>
      <span>Paciullo Gestão Comercial Ltda</span>
      <span>CNPJ 52.437.625/0001-19</span>
    </p>
  </div>
</footer>

<style>
  .ft { padding: 48px 0 32px; border-top: 1px solid var(--navy-line); }
  .ft__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 32px; }
  .ft__logo { height: 36px; width: auto; }
  .ft__nav { display: flex; flex-wrap: wrap; gap: 4px 24px; font-size: 14px; font-weight: 600; color: var(--muted-on-dark); }
  .ft__nav a { display: inline-block; padding: 11px 0; transition: color .3s; }
  .ft__nav a:hover { color: var(--green); }
  .ft__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; margin-top: 32px; padding-top: 24px; font-size: 14px; color: var(--muted-on-dark); align-items: flex-end; }
  .ft__legal { display: flex; flex-direction: column; align-items: flex-end; text-align: right; }
  @media (max-width: 640px) { .ft__legal { align-items: flex-start; text-align: left; } }
</style>
