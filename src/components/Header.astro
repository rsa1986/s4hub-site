---
import { Image } from 'astro:assets';
import logo from '../assets/logo-h-dark.png';
import { temClientes, temFaq } from '../data/site.js';
const links = [
  { href: '#solucoes', label: 'Soluções' },
  { href: '#metodo', label: 'Método' },
  ...(temClientes ? [{ href: '#clientes', label: 'Clientes' }] : []),
  ...(temFaq ? [{ href: '#duvidas', label: 'Dúvidas' }] : []),
];
---
<header class="hdr" data-header>
  <div class="wrap hdr__in">
    <a href="#topo" class="hdr__logo" aria-label="S4 Hub, voltar ao início">
      <!-- logo otimizado no build: WebP no tamanho exibido (1x e 2x para telas de alta densidade) -->
      <Image src={logo} alt="S4 Hub" height={30} densities={[1, 2]} format="webp" loading="eager" />
    </a>
    <nav class="hdr__nav" aria-label="Principal">
      {links.map((l) => <a href={l.href} class="hdr__link"><span>{l.label}</span></a>)}
    </nav>
    <a href="#contato" class="btn hdr__cta"><span>Diagnóstico<span class="hdr__cta-extra"> gratuito</span></span></a>
    <button class="hdr__burger" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-mobile" data-burger>
      <span></span><span></span>
    </button>
  </div>
  <div class="hdr__mobile" id="menu-mobile" data-mobile-menu hidden>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href="#contato" class="btn">Diagnóstico gratuito</a>
  </div>
  <!-- fundo escurecido atrás do menu mobile; tocar nele fecha o menu -->
  <div class="hdr__scrim" data-scrim hidden></div>
</header>

<style>
  .hdr {
    position: fixed; inset: 0 0 auto; z-index: 50; color: var(--white);
    transition: background-color .3s ease, transform .25s var(--ease), box-shadow .3s ease;
  }
  .hdr.is-solid { background: rgba(0, 33, 78, 0.86); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 1px 0 var(--navy-line); }
  .hdr.is-hidden { transform: translateY(-100%); }
  .hdr__in { display: flex; align-items: center; gap: 28px; height: 68px; }
  .hdr__logo { display: flex; align-items: center; min-height: 44px; }
  .hdr__logo img { height: 30px; width: auto; }
  .hdr__nav { display: flex; gap: 6px; margin-left: auto; }
  .hdr__link { position: relative; padding: 8px 12px; font-size: 14px; font-weight: 600; color: var(--muted-on-dark); transition: color .2s ease; }
  .hdr__link::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 2px; height: 2px; background: var(--green); transform: scaleX(0); transform-origin: right; transition: transform .25s var(--ease); }
  @media (hover: hover) and (pointer: fine) {
    .hdr__link:hover { color: var(--white); }
    .hdr__link:hover::after { transform: scaleX(1); transform-origin: left; }
  }
  .hdr__cta { min-height: 38px; padding: 0 18px; font-size: 14px; white-space: nowrap; }
  .hdr__burger { display: none; width: 46px; height: 46px; margin-left: auto; border: 0; background: transparent; cursor: pointer; position: relative; }
  .hdr__burger span { position: absolute; left: 11px; right: 11px; height: 2px; background: var(--white); transition: transform .2s var(--ease); }
  .hdr__burger span:first-child { top: 18px; }
  .hdr__burger span:last-child { top: 26px; }
  .hdr__burger[aria-expanded='true'] span:first-child { transform: translateY(4px) rotate(45deg); }
  .hdr__burger[aria-expanded='true'] span:last-child { transform: translateY(-4px) rotate(-45deg); }
  .hdr__mobile { display: flex; flex-direction: column; gap: 4px; padding: 8px var(--gutter) 28px; background: var(--navy); }
  .hdr__mobile[hidden] { display: none; }
  .hdr__mobile a:not(.btn) { padding: 14px 0; font-family: var(--f-display); font-size: 22px; font-weight: 600; border-bottom: 1px solid var(--navy-line); }
  .hdr__mobile .btn { margin-top: 20px; justify-content: center; }
  .hdr__scrim { position: fixed; inset: 60px 0 0; z-index: -1; background: rgba(0, 21, 53, 0.7); }
  .hdr__scrim[hidden] { display: none; }
  @media (max-width: 900px) {
    .hdr__nav { display: none; }
    /* no celular o botão de diagnóstico continua no header, compacto, ao lado do menu */
    .hdr__cta { margin-left: auto; min-height: 44px; padding: 0 16px; font-size: 13px; }
    .hdr__burger { display: block; margin-left: 0; }
    .hdr.menu-open .hdr__cta { visibility: hidden; } /* o menu aberto já tem o botão */
    .hdr__in { height: 60px; gap: 10px; }
    .hdr__logo img { height: 28px; }
  }
  /* telas muito estreitas: o botão do header fica só "Diagnóstico", numa linha */
  @media (max-width: 360px) {
    .hdr__cta-extra { display: none; }
  }
</style>
