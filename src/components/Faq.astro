---
import { faq } from '../data/site.js';
---
<!-- Poucas perguntas com respostas curtas: tudo aberto, sem acordeão (nada para clicar só para ler uma linha) -->
<section id="duvidas" class="fq">
  <div class="wrap rule-top fq__grid">
    <div class="fq__side">
      <h2 class="h-md">Perguntas que sempre aparecem.</h2>
    </div>
    <dl class="fq__list">
      {faq.map((f) => (
        <div class="fq__item">
          <dt>{f.p}</dt>
          <dd>{f.r}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .fq { padding: 0 0 var(--section-end); }
  .fq__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 96px); padding-top: var(--section); }
  .fq__side { display: flex; flex-direction: column; gap: 16px; }
  .fq__list { margin: 0; }
  .fq__item { padding: 22px 0; border-bottom: 1px solid var(--paper-line); }
  .fq__item:first-child { padding-top: 0; }
  .fq__item dt { font-family: var(--f-display); font-weight: 600; font-size: clamp(17px, 1.4vw, 19px); letter-spacing: -0.015em; line-height: 1.3; }
  .fq__item dd { margin: 8px 0 0; max-width: 560px; color: var(--muted); font-size: 15px; }
  @media (max-width: 900px) { .fq__grid { grid-template-columns: 1fr; } }
</style>
