---
import { frentes, produtos } from '../data/site.js';
const frase = 'Na S4 Hub, unimos estratégia e execução para acelerar seus resultados nos dois pilares essenciais de qualquer negócio: vendas e marketing.';
const palavras = frase.split(' ');
const nomeDo = Object.fromEntries(produtos.map((p) => [p.id, p.nome]));
---
<section class="mf" id="sobre">
  <div class="wrap">
    <h2 class="sr-only">O que fazemos</h2>
    <p class="mf__text" data-scrub-text>
      {palavras.map((w) => <span class="w">{w} </span>)}
    </p>

    <ul class="mf__list">
      {frentes.map((f) => (
        <li>
          <a class="mf__row" href={`#mod-${f.modulo}`}>
            <h3 class="mf__title">{f.titulo}</h3>
            <p class="mf__desc">{f.texto}</p>
            <span class="mf__mod">
              {nomeDo[f.modulo]}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .mf { padding: var(--section) 0; }
  .mf__text { max-width: 880px; font-family: var(--f-display); font-weight: 500; font-size: clamp(24px, 2.8vw, 40px); line-height: 1.18; letter-spacing: -0.025em; }
  .mf__text .w { color: rgba(11, 26, 46, 0.14); transition: color .2s; }
  .mf__text .w.on { color: var(--ink); }
  .mf__list { list-style: none; margin: clamp(48px, 6vw, 80px) 0 0; padding: 0; border-top: 1px solid var(--paper-line); }
  .mf__list li { border-bottom: 1px solid var(--paper-line); }
  .mf__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) 130px; gap: 32px; align-items: baseline; padding: 22px 0; }
  .mf__title { font-size: clamp(18px, 1.6vw, 22px); letter-spacing: -0.02em; line-height: 1.2; transition: color .35s; }
  .mf__desc { color: var(--muted); font-size: 15px; }
  .mf__mod { display: inline-flex; align-items: center; justify-content: flex-end; gap: 8px; font-weight: 700; font-size: 14px; color: var(--teal-ink); white-space: nowrap; }
  .mf__mod svg { width: 16px; height: 16px; transition: transform .45s var(--ease); }
  .mf__row:hover .mf__title, .mf__row:focus-visible .mf__title { color: var(--teal-ink); }
  .mf__row:hover .mf__mod svg { transform: translate(3px, -3px); }
  @media (max-width: 860px) {
    .mf__row { grid-template-columns: 1fr; gap: 8px; padding: 22px 0; }
    .mf__mod { justify-content: flex-start; margin-top: 6px; }
  }
</style>
