---
const { items = [], tone = 'navy', reverse = false } = Astro.props;
const loop = [...items, ...items];
---
<div class={`mq mq--${tone}`} data-marquee data-reverse={reverse ? 'true' : 'false'} aria-hidden="true">
  <div class="mq__track">
    {loop.map((t) => (
      <span class="mq__item">{t}<i class="mq__dot"></i></span>
    ))}
  </div>
</div>

<style>
  .mq { overflow: hidden; padding: 26px 0; white-space: nowrap; user-select: none; }
  .mq--green { background: var(--green); color: var(--navy); }
  .mq--navy { background: var(--navy-900); color: var(--white); border-block: 1px solid var(--navy-line); }
  .mq__track { display: inline-flex; will-change: transform; }
  .mq__item { display: inline-flex; align-items: center; gap: 0.6em; padding-right: 0.6em; font-family: var(--f-display); font-stretch: var(--condensed); font-weight: 700; font-size: clamp(30px, 4.4vw, 62px); letter-spacing: -0.02em; line-height: 1; }
  /* o mesmo ponto dos módulos do hub */
  .mq__dot { width: 0.22em; height: 0.22em; border-radius: 50%; background: currentColor; }
  .mq--navy .mq__dot { background: var(--green); }
</style>
