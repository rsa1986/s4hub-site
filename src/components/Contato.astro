---
import { contato, emailDefinido } from '../data/site.js';
---
<section id="contato" class="ct dark">
  <div class="wrap">
    <h2 class="h-xl ct__title">Vamos destravar<br />o seu crescimento?</h2>
    <div class="ct__grid">
      <div class="ct__info">
        <p class="ct__lead">Comece pelo diagnóstico gratuito. Conte um pouco sobre sua empresa e retornamos por e-mail para agendar a conversa.</p>
        {emailDefinido && <a class="ct__mail" href={`mailto:${contato.email}`}>{contato.email}</a>}
      </div>
      <form class="ct__form" action="/contato.php" method="post" data-form novalidate>
        <div class="ct__row">
          <div class="field"><input id="nome" name="nome" type="text" required autocomplete="name" placeholder=" " /><label for="nome">Nome <span class="field__req">(obrigatório)</span></label><p class="field__err" id="nome-err" data-err></p></div>
          <div class="field"><input id="empresa" name="empresa" type="text" autocomplete="organization" placeholder=" " /><label for="empresa">Empresa</label></div>
        </div>
        <div class="ct__row">
          <div class="field"><input id="email" name="email" type="email" required autocomplete="email" placeholder=" " /><label for="email">E-mail <span class="field__req">(obrigatório)</span></label><p class="field__err" id="email-err" data-err></p></div>
          <div class="field"><input id="telefone" name="telefone" type="tel" autocomplete="tel" placeholder=" " /><label for="telefone">Telefone</label></div>
        </div>
        <div class="field"><textarea id="mensagem" name="mensagem" rows="3" placeholder=" "></textarea><label for="mensagem">Qual é o principal desafio hoje?</label></div>
        <div class="hp" aria-hidden="true"><label for="site">Site</label><input id="site" name="site" type="text" tabindex="-1" autocomplete="off" /></div>
        <div class="ct__submit">
          <button type="submit" class="btn">Enviar e pedir diagnóstico</button>
          <p class="ct__status" role="status" aria-live="polite" data-form-status></p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .ct { padding: var(--section) 0; }
  .ct__title { font-size: clamp(36px, 4.6vw, 68px); }
  .ct__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); margin-top: clamp(36px, 4vw, 56px); }
  .ct__info { display: flex; flex-direction: column; gap: 20px; }
  .ct__lead { color: var(--muted-on-dark); font-size: 16px; max-width: 360px; }
  .ct__mail { font-family: var(--f-display); font-size: 18px; font-weight: 600; color: var(--green); }
  .ct__form { display: flex; flex-direction: column; gap: 4px; }
  .ct__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 28px; }
  .field { position: relative; padding-top: 18px; }
  .field input, .field textarea {
    width: 100%; padding: 10px 0 10px; border: 0; border-bottom: 1.5px solid rgba(255, 255, 255, 0.45); background: transparent;
    color: var(--white); font: inherit; font-size: 16px; border-radius: 0; resize: vertical; transition: border-color .3s;
  }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--green); }
  .field label { position: absolute; left: 0; top: 28px; color: var(--muted-on-dark); pointer-events: none; transition: transform .35s var(--ease), color .3s, font-size .35s var(--ease); transform-origin: left; }
  .field input:focus + label, .field input:not(:placeholder-shown) + label,
  .field textarea:focus + label, .field textarea:not(:placeholder-shown) + label { transform: translateY(-26px); font-size: 13px; color: var(--green); }
  .field__req { opacity: 0.8; }
  /* erro: linha vermelha + mensagem escrita logo abaixo do campo (a cor não é o único sinal) */
  .field.is-error input, .field.is-error input:focus { border-color: #ff8a7a; }
  .field__err { min-height: 0; padding-top: 6px; font-size: 14px; color: #ff8a7a; }
  .field__err:empty { display: none; }
  .btn:disabled { opacity: 0.7; cursor: progress; }
  .hp { position: absolute; left: -9999px; }
  .ct__submit { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 24px; }
  .ct__status { font-size: 15px; color: var(--muted-on-dark); }
  @media (max-width: 900px) { .ct__grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .ct__row { grid-template-columns: 1fr; } }
</style>
