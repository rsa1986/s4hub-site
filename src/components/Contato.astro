---
import { contato, emailDefinido } from '../data/site.js';
---
<section id="contato" class="ct dark">
  <div class="wrap">
    <h2 class="h-xl ct__title">Vamos destravar<br />o seu crescimento?</h2>
    <div class="ct__grid">
      <div class="ct__info">
        <p class="ct__lead">Comece pelo diagnóstico gratuito. Conte um pouco sobre sua empresa e retornamos por e-mail para agendar a conversa.</p>
        {emailDefinido && <a class="ct__mail" href={`mailto:${contato.email}`}>{contato.email}</a>}
      </div>
      <form class="ct__form" action="/contato.php" method="post" data-form novalidate>
        <div class="ct__row">
          <div class="field"><input id="nome" name="nome" type="text" required autocomplete="name" placeholder=" " /><label for="nome">Nome</label></div>
          <div class="field"><input id="empresa" name="empresa" type="text" autocomplete="organization" placeholder=" " /><label for="empresa">Empresa</label></div>
        </div>
        <div class="ct__row">
          <div class="field"><input id="email" name="email" type="email" required autocomplete="email" placeholder=" " /><label for="email">E-mail</label></div>
          <div class="field"><input id="telefone" name="telefone" type="tel" autocomplete="tel" placeholder=" " /><label for="telefone">Telefone</label></div>
        </div>
        <div class="field"><textarea id="mensagem" name="mensagem" rows="3" placeholder=" "></textarea><label for="mensagem">Qual é o principal desafio hoje?</label></div>
        <div class="hp" aria-hidden="true"><label for="site">Site</label><input id="site" name="site" type="text" tabindex="-1" autocomplete="off" /></div>
        <div class="ct__submit">
          <button type="submit" class="btn">Enviar e pedir diagnóstico</button>
          <p class="ct__status" role="status" aria-live="polite" data-form-status></p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .ct { padding: clamp(110px, 14vw, 190px) 0 clamp(80px, 10vw, 130px); }
  .ct__title { font-size: clamp(48px, 8.8vw, 136px); }
  .ct__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(40px, 7vw, 120px); margin-top: clamp(56px, 7vw, 96px); }
  .ct__info { display: flex; flex-direction: column; gap: 28px; }
  .ct__lead { color: var(--muted-on-dark); font-size: 18px; max-width: 400px; }
  .ct__mail { font-family: var(--f-display); font-size: 22px; font-weight: 600; color: var(--green); }
  .ct__form { display: flex; flex-direction: column; gap: 8px; }
  .ct__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; }
  .field { position: relative; padding-top: 22px; }
  .field input, .field textarea {
    width: 100%; padding: 12px 0 14px; border: 0; border-bottom: 1.5px solid rgba(255, 255, 255, 0.22); background: transparent;
    color: var(--white); font: inherit; font-size: 18px; border-radius: 0; resize: vertical; transition: border-color .3s;
  }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--green); }
  .field label { position: absolute; left: 0; top: 34px; color: var(--muted-on-dark); pointer-events: none; transition: transform .35s var(--ease), color .3s, font-size .35s var(--ease); transform-origin: left; }
  .field input:focus + label, .field input:not(:placeholder-shown) + label,
  .field textarea:focus + label, .field textarea:not(:placeholder-shown) + label { transform: translateY(-30px); font-size: 13px; color: var(--green); }
  .field.is-error input { border-color: #ff8a7a; }
  .hp { position: absolute; left: -9999px; }
  .ct__submit { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 28px; }
  .ct__status { font-size: 15px; color: var(--muted-on-dark); }
  @media (max-width: 900px) { .ct__grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .ct__row { grid-template-columns: 1fr; } }
</style>
