---
// Aparece quando `temClientes` (site.js) for true. Cliente sem logo aparece com o nome escrito.
import { clientes, temClientes } from '../data/site.js';
---
{temClientes && (
  <section id="clientes" class="cl dark">
    <div class="wrap cl__head">
      <h2 class="h-lg">Quem já cresce<br />com a S4 Hub.</h2>
      <p class="cl__lead">Negócios de diferentes portes e segmentos que confiaram em nós para estruturar e acelerar suas vendas e seu marketing.</p>
    </div>

    <div class="cl__mq" data-marquee data-speed="0.6" data-copies="3">
      <ul class="mq__track">
        {[...clientes, ...clientes, ...clientes].map((c, k) => (
          <li class="cl__item" aria-hidden={k >= clientes.length ? 'true' : undefined}>
            {c.logo
              ? <img src={c.logo} alt={k < clientes.length ? c.nome : ''} loading="lazy" class="cl__logo" />
              : <span class="cl__nome">{c.nome}</span>}
          </li>
        ))}
      </ul>
    </div>

    <div class="wrap cl__foot">
      <a href="#contato" class="btn btn--ghost">Quero ser o próximo case</a>
    </div>
  </section>
)}

<style>
  .cl { padding: var(--section) 0 var(--section-end); overflow: hidden; }
  .cl__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 64px; }
  .cl__lead { max-width: 380px; color: var(--muted-on-dark); }
  .cl__mq { overflow: hidden; white-space: nowrap; margin-top: clamp(40px, 5vw, 64px); padding-block: 24px; border-block: 1px solid var(--navy-line); }
  .cl__mq .mq__track { display: inline-flex; align-items: center; gap: clamp(40px, 5vw, 72px); margin: 0; padding: 0 clamp(40px, 5vw, 72px) 0 0; list-style: none; will-change: transform; }
  .cl__item { flex: 0 0 auto; display: flex; align-items: center; height: 40px; }
  .cl__logo { height: 36px; width: auto; max-width: 150px; object-fit: contain; filter: grayscale(1) brightness(2.2); opacity: .75; }
  .cl__nome { font-family: var(--f-display); font-weight: 600; font-size: 20px; letter-spacing: -0.02em; color: var(--muted-on-dark); }
  .cl__foot { margin-top: 40px; }
</style>
