---
// Só é renderizada quando houver logos em `clientes` (ver `temClientes` em site.js).
import { clientes, temClientes } from '../data/site.js';
const logos = clientes.filter((c) => c.logo);
---
{temClientes && (
  <section id="clientes" class="cl dark">
    <div class="wrap cl__head">
      <h2 class="h-lg">Quem já cresce<br />com a S4 Hub.</h2>
      <p class="cl__lead">Negócios de diferentes portes e segmentos que confiaram em nós para estruturar e acelerar suas vendas e seu marketing.</p>
    </div>

    <div class="cl__mq" data-marquee data-speed="0.6" data-copies="3">
      <div class="mq__track">
        {[...logos, ...logos, ...logos].map((c, k) => (
          <img src={c.logo} alt={k < logos.length ? c.nome : ''} loading="lazy" class="cl__logo" />
        ))}
      </div>
    </div>

    <div class="wrap cl__foot">
      <a href="#contato" class="btn btn--ghost">Quero ser o próximo case</a>
    </div>
  </section>
)}

<style>
  .cl { padding: clamp(96px, 13vw, 170px) 0; overflow: hidden; }
  .cl__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 32px 64px; }
  .cl__lead { max-width: 380px; color: var(--muted-on-dark); }
  .cl__mq { overflow: hidden; white-space: nowrap; margin-top: clamp(56px, 7vw, 96px); }
  .cl__mq .mq__track { display: inline-flex; align-items: center; gap: clamp(48px, 6vw, 96px); padding-right: clamp(48px, 6vw, 96px); will-change: transform; }
  .cl__logo { flex: 0 0 auto; height: 48px; width: auto; max-width: 180px; object-fit: contain; filter: grayscale(1) brightness(2.2); opacity: .75; }
  .cl__foot { margin-top: 56px; }
</style>
