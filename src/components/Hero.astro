---
import { produtos } from '../data/site.js';
import { hubPos } from '../data/hub.js';
const nodes = produtos.map((p, i) => ({ ...p, ...hubPos[i], curto: p.nome.replace('S4 ', '') }));
---
<section id="topo" class="hero dark">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <h1 class="h-xl hero__title" data-split-hero>
        <span class="line"><span>Vendas e</span></span>
        <span class="line"><span>marketing</span></span>
        <span class="line"><span>no mesmo</span></span>
        <span class="line"><span>time.</span></span>
      </h1>
      <p class="hero__lead" data-hero-fade>Diagnóstico inteligente, ferramentas certas e execução que gera resultado. Sem enrolação, com estratégia.</p>
      <div class="hero__ctas" data-hero-fade>
        <a href="#contato" class="btn" data-magnetic>
          Quero meu diagnóstico
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href="#solucoes" class="btn btn--ghost">Ver as soluções</a>
      </div>
    </div>

    <!-- O hub é navegação: cada módulo leva ao card dele em Soluções. -->
    <div class="hero__hub" data-hub>
      <svg viewBox="0 0 600 600" class="hub" role="group" aria-label="Módulos da S4 Hub">
        <defs>
          <radialGradient id="core" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#00e451" stop-opacity="0.55" />
            <stop offset="100%" stop-color="#00e451" stop-opacity="0" />
          </radialGradient>
        </defs>
        <g class="hub__orbits" aria-hidden="true">
          <circle cx="300" cy="300" r="150" class="orbit" />
          <circle cx="300" cy="300" r="232" class="orbit orbit--b" />
          <circle cx="300" cy="300" r="290" class="orbit orbit--c" />
        </g>
        {nodes.map((n, i) => (
          <g class="hub__link" data-link={i} aria-hidden="true">
            <line x1="300" y1="300" x2={n.x} y2={n.y} class="link" />
            <line x1="300" y1="300" x2={n.x} y2={n.y} class="pulse" />
          </g>
        ))}
        <g aria-hidden="true">
          <circle cx="300" cy="300" r="120" fill="url(#core)" class="hub__aura" />
          <circle cx="300" cy="300" r="56" class="hub__ring" />
          <circle cx="300" cy="300" r="56" class="hub__ring hub__ring--2" />
          <circle cx="300" cy="300" r="44" class="hub__core" />
          <text x="300" y="312" text-anchor="middle" class="hub__label">S4</text>
        </g>
        {nodes.map((n, i) => (
          <g class="hub__node" data-node>
            <a href={`#mod-${n.id}`} class="node" data-node-link={i} data-nome={n.nome} data-tag={n.tag} aria-label={`${n.nome}: ${n.tag}`}>
              <circle cx={n.x} cy={n.y} r="48" class="node__hit" />
              <circle cx={n.x} cy={n.y} r="34" class="node__bg" />
              <circle cx={n.x} cy={n.y} r="6" class="node__dot" />
              <text x={n.x} y={n.y + 58} text-anchor="middle" class="node__label">{n.curto}</text>
            </a>
          </g>
        ))}
      </svg>
      <p class="hub__caption" data-hub-caption aria-hidden="true"><strong></strong><span></span></p>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: min(100svh, 780px); display: flex; flex-direction: column; justify-content: center; padding: 100px 0 56px; overflow: hidden; }
  .hero__grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; gap: 48px; }
  .hero__lead { margin-top: 24px; max-width: 440px; font-size: 17px; color: var(--muted-on-dark); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  .hero__hub { position: relative; width: 100%; max-width: 420px; justify-self: center; }
  .hub { width: 100%; height: auto; overflow: visible; }
  .orbit { fill: none; stroke: rgba(255, 255, 255, 0.09); stroke-width: 1; stroke-dasharray: 2 8; transform-origin: 300px 300px; }
  .orbit--b { stroke: rgba(52, 175, 128, 0.22); stroke-dasharray: 1 14; }
  .orbit--c { stroke: rgba(255, 255, 255, 0.06); stroke-dasharray: none; }
  .link { stroke: rgba(255, 255, 255, 0.16); stroke-width: 1.2; transition: stroke .35s, stroke-width .35s; }
  .hub__link.is-on .link { stroke: var(--green); stroke-width: 2.4; }
  .pulse { stroke: var(--green); stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 14 400; stroke-dashoffset: 14; }
  .hub__ring { fill: none; stroke: var(--green); stroke-width: 1.5; transform-origin: 300px 300px; opacity: 0; }
  .hub__core { fill: var(--green); }
  .hub__label { font-family: var(--f-display); font-weight: 800; font-size: 34px; fill: var(--navy); letter-spacing: -0.04em; }
  .hub__node { transform-box: fill-box; transform-origin: center; }
  .node { cursor: pointer; outline: none; }
  .node__hit { fill: transparent; }
  .node__bg { fill: var(--navy-700); stroke: rgba(255, 255, 255, 0.14); stroke-width: 1; transition: fill .35s, stroke .35s; }
  .node__dot { fill: var(--teal); transition: fill .35s; }
  .node__label { font-family: var(--f-display); font-weight: 600; font-size: 19px; fill: #fff; letter-spacing: -0.01em; }
  .node:hover .node__bg, .node:focus-visible .node__bg { fill: var(--green); stroke: var(--green); }
  .node:hover .node__dot, .node:focus-visible .node__dot { fill: var(--navy); }
  .node:focus-visible .node__bg { stroke: var(--white); stroke-width: 3; }
  .hub__caption {
    min-height: 44px; margin-top: 12px; display: flex; flex-direction: column; align-items: center; gap: 2px;
    text-align: center; pointer-events: none; opacity: 0; transform: translateY(6px); transition: opacity .35s, transform .45s var(--ease);
  }
  .hub__caption.is-on { opacity: 1; transform: none; }
  .hub__caption strong { font-family: var(--f-display); font-size: 17px; letter-spacing: -0.02em; color: var(--green); }
  .hub__caption span { font-size: 14px; color: var(--muted-on-dark); }

  @media (hover: none) { .hub__caption { display: none; } }
  @media (max-width: 980px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__hub { max-width: 320px; justify-self: center; margin-top: 16px; }
  }
</style>
