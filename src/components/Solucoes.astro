---
import { produtos } from '../data/site.js';
import MiniHub from './MiniHub.astro';
---
<section id="solucoes" class="sol dark" data-hscroll>
  <div class="sol__pin">
    <div class="sol__head wrap">
      <div class="sol__progress" aria-hidden="true"><span data-hscroll-bar></span></div>
    </div>

    <div class="sol__track" data-hscroll-track>
      <div class="sol__intro">
        <h2 class="h-lg">Cinco módulos.<br />Um só hub.</h2>
        <p>Comece pelo que sua empresa mais precisa agora. Os módulos se conectam conforme o negócio cresce.</p>
      </div>

      {produtos.map((p, i) => (
        <article id={`mod-${p.id}`} class={p.destaque ? 'mod mod--entrada' : 'mod'}>
          <div class="mod__hub">
            <MiniHub ativo={i} tom={p.destaque ? 'light' : 'dark'} />
          </div>
          <div class="mod__body">
            {p.destaque && <p class="mod__destaque">{p.destaque}</p>}
            <h3 class="mod__name">{p.nome}</h3>
            <p class="mod__tag">{p.tag}</p>
            <p class="mod__text">{p.texto}</p>
          </div>
        </article>
      ))}

      <div class="sol__end">
        <p>Não sabe por onde começar?</p>
        <a href="#contato" class="btn">Fazer o diagnóstico</a>
      </div>
    </div>
  </div>
</section>

<style>
  .sol { position: relative; }
  .sol__pin { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding: 110px 0 60px; overflow: hidden; }
  .sol__head { display: flex; justify-content: flex-end; margin-bottom: 44px; }
  .sol__progress { width: min(320px, 40vw); height: 2px; background: var(--navy-line); position: relative; overflow: hidden; }
  .sol__progress span { position: absolute; inset: 0; background: var(--green); transform-origin: left; transform: scaleX(0); }
  .sol__track { display: flex; align-items: stretch; padding-inline: var(--gutter) calc(var(--gutter) * 2); width: max-content; will-change: transform; }
  .sol__intro { width: min(560px, 82vw); display: flex; flex-direction: column; justify-content: flex-end; gap: 28px; padding-right: 64px; }
  .sol__intro p { font-size: 18px; color: var(--muted-on-dark); max-width: 420px; }

  /* Módulos: painéis separados por uma linha vertical, sem caixa. O S4 Go (porta de entrada) é o único com fundo. */
  .mod { width: min(380px, 82vw); min-height: 560px; display: flex; flex-direction: column; justify-content: space-between; gap: 40px; padding: 8px 40px; border-left: 1px solid var(--navy-line); }
  .mod__hub { width: 132px; }
  .mod__name { font-size: clamp(44px, 4.4vw, 64px); font-stretch: var(--condensed); font-weight: 800; letter-spacing: -0.03em; }
  .mod__tag { margin-top: 12px; font-weight: 700; color: var(--green); }
  /* altura fixa de 4 linhas para os nomes dos módulos ficarem na mesma altura */
  .mod__text { margin-top: 14px; min-height: calc(1.6em * 4); color: var(--muted-on-dark); font-size: 16px; max-width: 320px; }

  .mod--entrada { width: min(600px, 86vw); margin-right: 24px; padding: 40px 44px; border: 0; border-radius: 28px; background: var(--green); color: var(--navy); }
  .mod--entrada + .mod { border-left: 0; }
  .mod--entrada .mod__hub { width: 200px; }
  .mod--entrada .mod__name { font-size: clamp(64px, 7vw, 108px); }
  .mod--entrada .mod__tag { color: var(--navy); font-size: 19px; }
  .mod--entrada .mod__text { color: rgba(0, 33, 78, 0.82); font-size: 18px; max-width: 420px; }
  .mod__destaque { margin-bottom: 18px; font-weight: 700; font-size: 15px; }

  .sol__end { width: min(420px, 82vw); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 24px; padding-left: 56px; border-left: 1px solid var(--navy-line); }
  .sol__end p { font-family: var(--f-display); font-size: clamp(30px, 3vw, 44px); font-weight: 700; letter-spacing: -0.035em; line-height: 1.05; }

  /* sem animação (ou sem JS) não existe o pin: a faixa vira rolagem horizontal nativa */
  :global(html:not(.js)) .sol__pin, :global(.reduced) .sol__pin { overflow-x: auto; }

  /* mobile/tablet: sem rolagem horizontal fixa, módulos empilhados */
  @media (max-width: 900px) {
    .sol__pin { padding: 96px 0 72px; }
    .sol__head { display: none; }
    .sol__track { flex-direction: column; width: 100%; padding-inline: var(--gutter); }
    .sol__intro, .mod, .sol__end { width: 100%; }
    .sol__intro { padding: 0 0 48px; }
    .mod { min-height: 0; flex-direction: row; align-items: flex-start; gap: 24px; padding: 36px 0; border-left: 0; border-top: 1px solid var(--navy-line); }
    .mod__hub { flex: 0 0 72px; width: 72px; margin-top: 8px; }
    .mod__text { min-height: 0; }
    .mod--entrada { flex-direction: column; margin: 0 0 12px; padding: 32px 28px; border-radius: 22px; }
    .mod--entrada .mod__hub { width: 120px; flex-basis: auto; }
    .mod--entrada + .mod { border-top: 0; }
    .sol__end { padding: 48px 0 0; border-left: 0; border-top: 1px solid var(--navy-line); }
  }
</style>
