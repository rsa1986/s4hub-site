---
import { produtos } from '../data/site.js';
import MiniHub from './MiniHub.astro';
---
<section id="solucoes" class="sol dark" data-hscroll>
  <div class="sol__pin">
    <div class="sol__head wrap">
      <div class="sol__progress" aria-hidden="true"><span data-hscroll-bar></span></div>
    </div>

    <div class="sol__track" data-hscroll-track>
      <div class="sol__intro">
        <h2 class="h-lg">Cinco módulos.<br />Um só hub.</h2>
        <p>Comece pelo que sua empresa mais precisa agora. Os módulos se conectam conforme o negócio cresce.</p>
      </div>

      {produtos.map((p, i) => (
        <article id={`mod-${p.id}`} class={p.destaque ? 'mod mod--entrada' : 'mod'}>
          <div class="mod__hub">
            <MiniHub ativo={i} tom={p.destaque ? 'light' : 'dark'} />
          </div>
          <div class="mod__body">
            {p.destaque && <p class="mod__destaque">{p.destaque}</p>}
            <h3 class="mod__name">{p.nome}</h3>
            <p class="mod__tag">{p.tag}</p>
            <p class="mod__text">{p.texto}</p>
          </div>
        </article>
      ))}

      <div class="sol__end">
        <p>Não sabe por onde começar?</p>
        <a href="#contato" class="btn">Fazer o diagnóstico</a>
      </div>
    </div>
  </div>
</section>

<style>
  .sol { position: relative; }
  .sol__pin { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding: 88px 0 48px; overflow: hidden; }
  .sol__head { display: flex; justify-content: flex-end; margin-bottom: 32px; }
  .sol__progress { width: min(240px, 40vw); height: 2px; background: var(--navy-line); position: relative; overflow: hidden; }
  .sol__progress span { position: absolute; inset: 0; background: var(--green); transform-origin: left; transform: scaleX(0); }
  .sol__track { display: flex; align-items: stretch; padding-inline: var(--gutter) calc(var(--gutter) * 2); width: max-content; will-change: transform; }
  .sol__intro { width: min(440px, 82vw); display: flex; flex-direction: column; justify-content: flex-end; gap: 20px; padding-right: 56px; }
  .sol__intro p { font-size: 16px; color: var(--muted-on-dark); max-width: 360px; }

  /* Módulos: painéis separados por uma linha vertical, sem caixa. O S4 Go (porta de entrada) é o único com fundo. */
  .mod { width: min(300px, 82vw); min-height: 380px; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; padding: 4px 32px; border-left: 1px solid var(--navy-line); }
  .mod__hub { width: 88px; }
  .mod__name { font-size: clamp(28px, 2.6vw, 38px); font-stretch: var(--condensed); font-weight: 700; letter-spacing: -0.015em; }
  .mod__tag { margin-top: 8px; font-weight: 700; font-size: 14px; color: var(--green); }
  /* altura fixa de 4 linhas para os nomes dos módulos ficarem na mesma altura */
  .mod__text { margin-top: 10px; min-height: calc(1.55em * 4); color: var(--muted-on-dark); font-size: 15px; line-height: 1.55; max-width: 260px; }

  .mod--entrada { width: min(420px, 86vw); margin-right: 16px; padding: 28px 32px; border: 0; border-radius: 20px; background: var(--green); color: var(--navy); }
  .mod--entrada + .mod { border-left: 0; }
  .mod--entrada .mod__hub { width: 120px; }
  .mod--entrada .mod__name { font-size: clamp(40px, 4vw, 56px); }
  .mod--entrada .mod__tag { color: var(--navy); font-size: 15px; }
  .mod--entrada .mod__text { color: rgba(0, 33, 78, 0.82); font-size: 15px; max-width: 320px; }
  .mod__destaque { margin-bottom: 12px; font-weight: 700; font-size: 14px; }

  .sol__end { width: min(340px, 82vw); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 20px; padding-left: 40px; border-left: 1px solid var(--navy-line); }
  .sol__end p { font-family: var(--f-display); font-size: clamp(22px, 2vw, 28px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.1; }

  /* sem animação (ou sem JS) não existe o pin: a faixa vira rolagem horizontal nativa */
  :global(html:not(.js)) .sol__pin, :global(.reduced) .sol__pin { overflow-x: auto; }

  /* mobile/tablet: sem rolagem horizontal fixa, módulos empilhados */
  @media (max-width: 900px) {
    .sol__pin { min-height: 0; padding: var(--section) 0; }
    .sol__head { display: none; }
    .sol__track { flex-direction: column; width: 100%; padding-inline: var(--gutter); }
    .sol__intro, .mod, .sol__end { width: 100%; }
    .sol__intro { padding: 0 0 36px; }
    .mod { min-height: 0; flex-direction: row; align-items: flex-start; gap: 20px; padding: 28px 0; border-left: 0; border-top: 1px solid var(--navy-line); }
    .mod__hub { flex: 0 0 56px; width: 56px; margin-top: 4px; }
    .mod__text { min-height: 0; max-width: none; }
    .mod--entrada { flex-direction: column; margin: 0 0 8px; padding: 24px; border-radius: 18px; }
    .mod--entrada .mod__hub { width: 88px; flex-basis: auto; }
    .mod--entrada + .mod { border-top: 0; }
    .sol__end { padding: 36px 0 0; border-left: 0; border-top: 1px solid var(--navy-line); }
  }
</style>
