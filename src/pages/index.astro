---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Manifesto from '../components/Manifesto.astro';
import Solucoes from '../components/Solucoes.astro';
import Metodo from '../components/Metodo.astro';
import Clientes from '../components/Clientes.astro';
import Parceiros from '../components/Parceiros.astro';
import Faq from '../components/Faq.astro';
import Contato from '../components/Contato.astro';
import Footer from '../components/Footer.astro';
import { textos } from '../data/site.js';
---
<Base>
  <a class="skip" href="#conteudo">Pular para o conteúdo</a>
  <Header />
  <main id="conteudo" tabindex="-1">
    <Hero />
    {textos.faixa.length > 0 && <Marquee tone="navy" items={textos.faixa} />}
    <Manifesto />
    <Solucoes />
    <Metodo />
    <Clientes />
    <Parceiros />
    <Faq />
    <Contato />
  </main>
  <Footer />
</Base>
