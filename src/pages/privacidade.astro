---
// Política de privacidade (LGPD). O texto fica em src/content/privacidade.md e é editado pelo painel.
import PaginaSimples from '../components/PaginaSimples.astro';
import { Content, frontmatter } from '../content/privacidade.md';
const { titulo, atualizado } = frontmatter;
---
<PaginaSimples title={`${titulo} | S4 Hub`} description="Como a S4 Hub trata os dados pessoais de quem visita o site e preenche o formulário de contato (LGPD).">
  <h1 class="h-lg">{titulo}</h1>
  <p class="pv__data">Última atualização: {atualizado}</p>
  <div class="pv__texto">
    <Content />
  </div>
</PaginaSimples>

<style>
  .pv__data { margin-top: 16px; font-size: 14px; color: var(--muted); }
  /* texto da política (vem do Markdown): medida de leitura confortável e ritmo de documento */
  .pv__texto { margin-top: clamp(32px, 4vw, 48px); color: var(--ink); font-size: 16px; line-height: 1.7; }
  .pv__texto :global(h2) { margin: 40px 0 12px; font-size: clamp(20px, 2vw, 24px); letter-spacing: -0.02em; line-height: 1.25; }
  .pv__texto :global(p), .pv__texto :global(ul) { margin: 0 0 14px; max-width: 68ch; }
  .pv__texto :global(ul) { padding-left: 22px; }
  .pv__texto :global(li) { margin-bottom: 6px; }
  .pv__texto :global(strong) { font-weight: 700; }
  .pv__texto :global(a) { color: var(--teal-ink); text-decoration: underline; text-underline-offset: 3px; }
</style>
