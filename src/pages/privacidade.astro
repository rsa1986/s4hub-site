---
// Política de privacidade (LGPD). O texto fica em src/content/privacidade.md e é editado pelo painel.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import logo from '../assets/logo-h-dark.png';
import { Content, frontmatter } from '../content/privacidade.md';
const { titulo, atualizado } = frontmatter;
---
<Base title={`${titulo} | S4 Hub`} description="Como a S4 Hub trata os dados pessoais de quem visita o site e preenche o formulário de contato (LGPD)." motion={false}>
  <a class="skip" href="#conteudo">Pular para o conteúdo</a>
  <header class="pv-hdr dark">
    <div class="wrap pv-hdr__in">
      <a href="/" class="pv-hdr__logo" aria-label="S4 Hub, voltar ao site">
        <Image src={logo} alt="S4 Hub" height={30} densities={[1, 2]} format="webp" loading="eager" />
      </a>
      <a href="/" class="pv-hdr__voltar">Voltar ao site</a>
    </div>
  </header>

  <main id="conteudo" tabindex="-1" class="pv">
    <div class="wrap pv__in">
      <h1 class="h-lg">{titulo}</h1>
      <p class="pv__data">Última atualização: {atualizado}</p>
      <div class="pv__texto">
        <Content />
      </div>
    </div>
  </main>

  <Footer base="/" />
</Base>

<style>
  .pv-hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 68px; }
  .pv-hdr__logo { display: flex; align-items: center; min-height: 44px; }
  .pv-hdr__logo img { height: 30px; width: auto; }
  .pv-hdr__voltar { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; font-weight: 600; color: var(--white); text-decoration: underline; text-underline-offset: 6px; text-decoration-color: rgba(255, 255, 255, 0.45); }
  @media (hover: hover) and (pointer: fine) { .pv-hdr__voltar:hover { color: var(--green); text-decoration-color: var(--green); } }

  .pv { padding: clamp(48px, 7vw, 96px) 0 var(--section-end); }
  .pv__in { max-width: 760px; }
  .pv__data { margin-top: 16px; font-size: 14px; color: var(--muted); }

  /* texto da política (vem do Markdown): medida de leitura confortável e ritmo de documento */
  .pv__texto { margin-top: clamp(32px, 4vw, 48px); color: var(--ink); font-size: 16px; line-height: 1.7; }
  .pv__texto :global(h2) { margin: 40px 0 12px; font-size: clamp(20px, 2vw, 24px); letter-spacing: -0.02em; line-height: 1.25; }
  .pv__texto :global(p), .pv__texto :global(ul) { margin: 0 0 14px; max-width: 68ch; }
  .pv__texto :global(ul) { padding-left: 22px; }
  .pv__texto :global(li) { margin-bottom: 6px; }
  .pv__texto :global(strong) { font-weight: 700; }
  .pv__texto :global(a) { color: var(--teal-ink); text-decoration: underline; text-underline-offset: 3px; }
</style>
