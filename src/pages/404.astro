---
// Página para endereços que não existem (o .htaccess aponta o erro 404 para cá).
import PaginaSimples from '../components/PaginaSimples.astro';
import MiniHub from '../components/MiniHub.astro';
---
<PaginaSimples title="Página não encontrada | S4 Hub" description="Este endereço não existe no site da S4 Hub." noindex>
  <div class="nf">
    <div class="nf__hub"><MiniHub ativo={-1} tom="paper" /></div>
    <h1 class="h-lg">Esta página não existe.</h1>
    <p>O endereço pode ter mudado ou sido digitado errado. Tudo o que a S4 Hub oferece está na página principal.</p>
    <a href="/" class="btn btn--navy">Ir para a página principal</a>
  </div>
</PaginaSimples>

<style>
  .nf { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .nf__hub { width: 96px; margin-bottom: 8px; }
  .nf p { color: var(--muted); max-width: 52ch; }
  .nf .btn { margin-top: 12px; }
</style>
