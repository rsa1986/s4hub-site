# Configuração do servidor (Apache do HostGator). Vai junto com o site em todo build.

Options -Indexes
# o site novo é index.html (se sobrar um index.php do WordPress, ele não ganha)
DirectoryIndex index.html

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # sempre https e sem www (como o site já faz hoje)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://s4hub.com.br%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.s4hub\.com\.br$ [NC]
  RewriteRule ^ https://s4hub.com.br%{REQUEST_URI} [L,R=301]

  # cópia do WordPress antigo guardada no servidor: inacessível pela web
  # (reforçado abaixo com Require, porque o .htaccess do WordPress dentro da pasta anula esta regra)
  RewriteRule ^wp-antigo(/|$) - [F,L]

  # endereços do WordPress antigo que estavam no Google (sem conteúdo próprio): vão para a home
  RewriteRule ^hello-world/?$ https://s4hub.com.br/ [L,R=301]
  RewriteRule ^category/ https://s4hub.com.br/ [L,R=301]
  RewriteRule ^author/ https://s4hub.com.br/ [L,R=301]
  RewriteRule ^(comments/)?feed/?$ https://s4hub.com.br/ [L,R=301]
  # mapas do site antigos (Yoast) apontam para o novo
  RewriteRule ^(sitemap_index|wp-sitemap|post-sitemap|page-sitemap|category-sitemap|author-sitemap)\.xml$ https://s4hub.com.br/sitemap.xml [L,R=301]
</IfModule>

# arquivos ocultos (ex.: registro da publicação automática) e a senha do e-mail não são servidos
<FilesMatch "^(\.|smtp-config\.php$)">
  Require all denied
</FilesMatch>

# qualquer pasta wp-antigo (cópia do WordPress, backups): negada antes de qualquer regra de reescrita.
# Um .htaccess dentro dela (o do WordPress tem RewriteEngine On) NÃO consegue anular este bloqueio.
# (sem <If>: no Apache do HostGator um <If> aqui fazia sumir os cabeçalhos de segurança)
SetEnvIf Request_URI "^/wp-antigo(/|$)" wp_antigo
<RequireAll>
  Require all granted
  Require not env wp_antigo
</RequireAll>

# compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # arquivos com hash no nome (/_astro/) nunca mudam: cache longo. HTML e o resto: sempre conferir
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <Else>
    Header set Cache-Control "no-cache"
  </Else>

  # cabeçalhos de segurança
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
